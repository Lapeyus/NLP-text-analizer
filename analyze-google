#!/usr/bin/env python3
"""
Analiza texto con la API OFICIAL de Google Cloud Natural Language.

    ./analyze-google sentiment "The food was amazing but the service was terrible."
    ./analyze-google entities  "Apple opened a new store in Mexico City."
    ./analyze-google classify  --file articulo.txt

Requiere: la API habilitada en tu proyecto, credenciales (ADC o key.json) y
conexión. Cada llamada consume cuota facturable.

Es un atajo de `analyze.py --backend google`; acepta las mismas opciones.
Para la alternativa sin cuota ni conexión, usa ./analyze-local.
"""

import sys

from analyze import main

if __name__ == "__main__":
    # Fijamos el backend y dejamos pasar el resto de argumentos tal cual, para
    # que este ejecutable no se quede atrás si analyze.py gana opciones.
    argv = [a for a in sys.argv[1:] if a != "--backend"]
    sys.exit(main(argv + ["--backend", "google"]))
